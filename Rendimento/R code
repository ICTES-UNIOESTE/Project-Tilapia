# ======================
# Formatação numérica em português brasileiro
# ======================

fmt_num_pt <- function(x, digits = 2, drop0 = TRUE) {
  out <- ifelse(
    is.na(x),
    NA_character_,
    formatC(
      x,
      format = "f",
      digits = digits,
      decimal.mark = ",",
      big.mark = "."
    )
  )
  
  if (drop0) {
    out <- stringr::str_replace(out, "(,\\d*?)0+$", "\\1")
    out <- stringr::str_replace(out, ",$", "")
  }
  
  out
}

fmt_percent_pt <- function(x, digits = 2, drop0 = TRUE) {
  ifelse(
    is.na(x),
    NA_character_,
    paste0(fmt_num_pt(x, digits = digits, drop0 = drop0), "%")
  )
}

label_num_pt <- function(digits = 2, drop0 = TRUE) {
  function(x) fmt_num_pt(x, digits = digits, drop0 = drop0)
}

label_percent_pt <- function(digits = 2, drop0 = TRUE) {
  function(x) fmt_percent_pt(x, digits = digits, drop0 = drop0)
}

# Funções para aumentar o número de marcas nos eixos Y
# e formatar os valores com vírgula decimal, no padrão brasileiro.
eixo_y_temporal <- function(n = 8, expand_top = 0.10, digits = 2) {
  scale_y_continuous(
    breaks = scales::breaks_pretty(n = n),
    labels = label_num_pt(digits = digits),
    expand = expansion(mult = c(0, expand_top))
  )
}

eixo_y_temporal_percentual <- function(n = 8, expand_top = 0.15, digits = 2) {
  scale_y_continuous(
    breaks = scales::breaks_pretty(n = n),
    labels = label_percent_pt(digits = digits),
    expand = expansion(mult = c(0, expand_top))
  )
}

# ======================
# 3. Ler um arquivo Rendimento YYYY
# ======================

ler_rendimento_ano <- function(arquivo) {
  
  ano_file <- str_extract(basename(arquivo), "\\d{4}") %>% as.integer()
  abas <- readxl::excel_sheets(arquivo)
  
  ler_aba <- function(aba_atual) {
    df <- suppressWarnings(readxl::read_excel(arquivo, sheet = aba_atual)) %>%
      janitor::clean_names()
    
    df <- df %>%
      rename(
        especie = any_of(c(
          "especie", "especies", "esp_cie", "esp_cies", "species"
        )),
        semanatot = any_of(c(
          "semanatot", "semana_tot", "semana_total", "total_semana",
          "peso_semana", "peso_total", "kg", "quilograma"
        )),
        diastot = any_of(c(
          "diastot", "dias_tot", "dias_total", "total_dias", "dias", "n_dias"
        )),
        data = any_of(c(
          "data", "date", "periodo", "per_odo"
        )),
        zona = any_of(c(
          "zona", "zona_de_pesca", "zona_pesca", "regiao", "regi_o"
        )),
        area = any_of(c(
          "area", "area_de_pesca", "area_pesca"
        )),
        ponto = any_of(c(
          "ponto", "ponto_", "ponto_de_pesca", "ponto_pesca"
        )),
        pescador_cod = any_of(c(
          "pescador_cod", "pescador_codigo", "pescador_c_digo",
          "codigo_pescador", "cod_pescador", "pescador"
        )),
        local = any_of(c(
          "local", "localidade"
        ))
      )
    
    semana_cols_detectadas <- names(df)[str_detect(names(df), "^semana_?[1-5]$")]
    dias_cols_detectadas <- names(df)[str_detect(names(df), "^dias?_?[1-5]$")]
    
    if (!("especie" %in% names(df)) ||
        (!("semanatot" %in% names(df)) && length(semana_cols_detectadas) == 0)) {
      return(NULL)
    }
    
    # Colunas opcionais
    if (!"data" %in% names(df)) df$data <- NA_character_
    if (!"zona" %in% names(df)) df$zona <- NA_character_
    if (!"area" %in% names(df)) df$area <- NA_character_
    if (!"ponto" %in% names(df)) {
      if ("local" %in% names(df)) {
        df$ponto <- df$local
      } else {
        df$ponto <- NA_character_
      }
    }
    if (!"pescador_cod" %in% names(df)) df$pescador_cod <- NA_character_
    if (!"semanatot" %in% names(df)) df$semanatot <- NA_character_
    if (!"diastot" %in% names(df)) df$diastot <- NA_character_
    
    # Em alguns anos/abas, principalmente na estrutura antiga,
    # SEMANATOT ou DIASTOT podem estar ausentes ou vazios mesmo quando
    # SEMANA1–SEMANA5 ou DIAS1–DIAS5 estão preenchidos.
    # Aqui calculamos os totais a partir das colunas semanais quando necessário.
    soma_linhas_numericas <- function(data, cols) {
      if (length(cols) == 0) return(rep(NA_real_, nrow(data)))
      tmp <- as.data.frame(lapply(data[cols], to_number))
      n_validos <- rowSums(!is.na(tmp))
      soma <- rowSums(tmp, na.rm = TRUE)
      soma[n_validos == 0 | soma <= 0] <- NA_real_
      soma
    }
    
    df$.semanatot_lido <- to_number(df$semanatot)
    df$.semanatot_soma_semanas <- soma_linhas_numericas(df, semana_cols_detectadas)
    df$.semanatot_final <- dplyr::coalesce(df$.semanatot_lido, df$.semanatot_soma_semanas)
    
    df$.diastot_lido <- to_number(df$diastot)
    df$.diastot_soma_dias <- soma_linhas_numericas(df, dias_cols_detectadas)
    df$.diastot_final <- dplyr::coalesce(df$.diastot_lido, df$.diastot_soma_dias)
    
    # A CPUE é calculada em todos os anos quando DIASTOT existe e é > 0.
    # Isso inclui 2008 e 2009, pois esses anos possuem DIASTOT.
    out <- df %>%
      transmute(
        ano = ano_file,
        arquivo = basename(arquivo),
        caminho_arquivo = arquivo,
        aba = aba_atual,
        
        data_original = as.character(data),
        data = parse_data_robusta(data),
        mes_num = month(data),
        mes_nome = nome_mes_pt(mes_num),
        
        especie_original = as.character(especie) %>% str_squish(),
        especie_limpa = limpar_texto(especie_original),
        especie_codigo_normalizado = normalizar_codigo_especie(especie_original),
        grupo_especie_rendimento = classificar_grupo_especie(especie_limpa),
        is_tilapia = grupo_especie_rendimento == "Tilápias",
        
        zona = padronizar_zona(zona),
        
        area = as.character(area) %>% str_squish(),
        area = ifelse(is.na(area) | area == "", "Não informado", area),
        
        ponto = as.character(ponto) %>% str_squish(),
        ponto = ifelse(is.na(ponto) | ponto == "", "Não informado", ponto),
        
        pescador_cod = as.character(pescador_cod) %>% str_squish(),
        
        semanatot = .semanatot_final,
        semanatot_lido = .semanatot_lido,
        semanatot_soma_semanas = .semanatot_soma_semanas,
        origem_semanatot = case_when(
          !is.na(.semanatot_lido) ~ "SEMANATOT",
          is.na(.semanatot_lido) & !is.na(.semanatot_soma_semanas) ~ "Soma de SEMANA1–SEMANA5",
          TRUE ~ "Sem rendimento válido"
        ),
        diastot_original = .diastot_final,
        diastot_lido = .diastot_lido,
        diastot_soma_dias = .diastot_soma_dias,
        origem_diastot = case_when(
          !is.na(.diastot_lido) ~ "DIASTOT",
          is.na(.diastot_lido) & !is.na(.diastot_soma_dias) ~ "Soma de DIAS1–DIAS5",
          TRUE ~ "Sem esforço válido"
        ),
        diastot = diastot_original,
        
        cpue = ifelse(
          !is.na(semanatot) & !is.na(diastot) & diastot > 0,
          semanatot / diastot,
          NA_real_
        ),
        
        cpue_disponivel = !is.na(semanatot) & !is.na(diastot) & diastot > 0,
        observacao_cpue = case_when(
          is.na(semanatot) | semanatot <= 0 ~ "Sem rendimento válido",
          is.na(diastot) | diastot <= 0 ~ "Sem DIASTOT válido para CPUE",
          TRUE ~ "CPUE calculável"
        )
      ) %>%
      filter(
        !is.na(especie_limpa),
        especie_limpa != "",
        !is.na(semanatot)
      )
    
    out$.n_linhas_validas_aba <- nrow(out)
    out$.n_tilapias_aba <- sum(out$is_tilapia, na.rm = TRUE)
    out$.prioridade_aba <- case_when(
      limpar_texto(aba_atual) == "revisado" ~ 1L,
      str_detect(limpar_texto(aba_atual), "banco de dados") ~ 2L,
      str_detect(limpar_texto(aba_atual), "rendimento") ~ 3L,
      TRUE ~ 4L
    )
    
    out
  }
  
  abas_lidas <- purrr::map(abas, purrr::possibly(ler_aba, otherwise = NULL)) %>%
    purrr::compact()
  
  if (length(abas_lidas) == 0) {
    warning(
      "Arquivo ignorado porque nenhuma aba em ", basename(arquivo),
      " possui as colunas mínimas esperadas: ESPECIE e SEMANATOT."
    )
    return(NULL)
  }
  
  diagnostico_abas <- purrr::map_dfr(
    abas_lidas,
    ~ tibble(
      aba = unique(.x$aba),
      n_linhas_validas = unique(.x$.n_linhas_validas_aba),
      n_tilapias = unique(.x$.n_tilapias_aba),
      prioridade = unique(.x$.prioridade_aba)
    )
  ) %>%
    mutate(
      tem_tilapia = n_tilapias > 0,
      resumo_aba = paste0(aba, " [linhas=", n_linhas_validas, "; tilápias=", n_tilapias, "]")
    ) %>%
    arrange(
      desc(tem_tilapia),
      desc(n_tilapias),
      prioridade,
      desc(n_linhas_validas)
    )
  
  # Escolhe uma única aba por arquivo para evitar duplicação.
  # Critério corrigido:
  #   1) primeiro escolhe abas que contenham tilápias, incluindo o código "tilapi";
  #   2) entre elas, escolhe a aba com maior número de registros de tilápia;
  #   3) em caso de empate, usa a prioridade do nome da aba;
  #   4) se nenhuma aba tiver tilápia, usa a aba com mais linhas válidas.
  #
  # Isso corrige o problema de anos como 2008, 2009, 2011 e 2014 ficarem zerados
  # quando o script escolhia uma aba maior, mas sem os registros codificados como "tilapi".
  aba_escolhida <- diagnostico_abas$aba[1]
  resumo_abas <- paste(diagnostico_abas$resumo_aba, collapse = "; ")
  abas_com_tilapia <- diagnostico_abas %>%
    filter(n_tilapias > 0) %>%
    pull(aba) %>%
    paste(collapse = "; ")
  
  idx_escolhida <- which(purrr::map_chr(abas_lidas, ~ unique(.x$aba)) == aba_escolhida)[1]
  
  out_final <- abas_lidas[[idx_escolhida]] %>%
    mutate(
      abas_validas_no_arquivo = paste(diagnostico_abas$aba, collapse = "; "),
      resumo_abas_validas_no_arquivo = resumo_abas,
      abas_com_tilapia_no_arquivo = ifelse(abas_com_tilapia == "", NA_character_, abas_com_tilapia),
      aba_escolhida = aba_escolhida,
      n_abas_validas_no_arquivo = nrow(diagnostico_abas),
      n_tilapias_aba_escolhida = diagnostico_abas$n_tilapias[diagnostico_abas$aba == aba_escolhida][1],
      criterio_escolha_aba = ifelse(
        n_tilapias_aba_escolhida > 0,
        "Aba com maior número de registros de tilápia, incluindo código tilapi",
        "Nenhuma aba tinha tilápia; escolhida aba com mais linhas válidas"
      )
    ) %>%
    select(-.n_linhas_validas_aba, -.n_tilapias_aba, -.prioridade_aba)
  
  out_final
}

