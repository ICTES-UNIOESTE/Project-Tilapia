  ) %>%
  filter(!is.na(area_key) | !is.na(ponto_key)) %>%
  distinct()

# Referência por combinação AREA + PONTO
# Essa é a correção mais segura.
ref_area_ponto <- ref_espacial %>%
  filter(!is.na(area_key), !is.na(ponto_key)) %>%
  count(area_key, ponto_key, area_ref, ponto_ref, zona_ref, name = "n") %>%
  group_by(area_key, ponto_key) %>%
