ler_rendimento_ano <- function(arquivo) {
  
  ano_file <- str_extract(basename(arquivo), "\\d{4}") %>% as.integer()
  abas <- readxl::excel_sheets(arquivo)
  
  aba_escolhida <- case_when(
    any(limpar_texto(abas) == "revisado") ~ abas[limpar_texto(abas) == "revisado"][1],
    any(str_detect(limpar_texto(abas), "banco de dados")) ~ abas[str_detect(limpar_texto(abas), "banco de dados")][1],
    any(str_detect(limpar_texto(abas), "rendimento")) ~ abas[str_detect(limpar_texto(abas), "rendimento")][1],
    TRUE ~ abas[1]
  )
  
  df <- suppressWarnings(readxl::read_excel(arquivo, sheet = aba_escolhida)) %>%
    janitor::clean_names()
  
  df <- df %>%
    rename(
      especie = any_of(c(
        "especie",
        "especies",
        "esp_cie",
        "esp_cies",
        "species"
      )),
      semanatot = any_of(c(
        "semanatot",
        "semana_tot",
        "semana_total",
        "total_semana",
        "peso_semana",
        "peso_total",
        "kg",
        "quilograma"
      )),
      diastot = any_of(c(
        "diastot",
        "dias_tot",
        "dias_total",
        "total_dias",
        "dias",
        "n_dias"
      )),
      data = any_of(c(
        "data",
        "date",
        "periodo",
        "per_odo"
      )),
      zona = any_of(c(
        "zona",
        "zona_de_pesca",
        "zona_pesca",
        "regiao",
        "regi_o"
      )),
      area = any_of(c(
        "area",
        "area_de_pesca",
        "area_pesca"
      )),
      ponto = any_of(c(
        "ponto",
        "ponto_",
        "ponto_de_pesca",
        "ponto_pesca"
      )),
      pescador_cod = any_of(c(
        "pescador_cod",
        "pescador_codigo",
        "pescador_c_digo",
        "codigo_pescador",
        "cod_pescador"
      ))
    )
  
  # Apenas estas três colunas são obrigatórias
  if (!all(c("especie", "semanatot", "diastot") %in% names(df))) {
    warning(
      "Arquivo ignorado porque a aba selecionada em ", basename(arquivo),
      " não possui as colunas mínimas esperadas: ESPECIE, SEMANATOT e DIASTOT."
    )
    return(NULL)
  }
  
  # Colunas opcionais
  if (!"data" %in% names(df)) df$data <- NA_character_
  if (!"zona" %in% names(df)) df$zona <- NA_character_
  if (!"area" %in% names(df)) df$area <- NA_character_
  if (!"ponto" %in% names(df)) df$ponto <- NA_character_
  if (!"pescador_cod" %in% names(df)) df$pescador_cod <- NA_character_
  
  df %>%
    transmute(
      ano = ano_file,
      arquivo = basename(arquivo),
      caminho_arquivo = arquivo,
      aba = aba_escolhida,
      
      data_original = as.character(data),
      data = parse_data_robusta(data),
      mes_num = month(data),
      mes_nome = nome_mes_pt(mes_num),
      
      especie_original = as.character(especie) %>% str_squish(),
      especie_limpa = limpar_texto(especie_original),
      
      zona = padronizar_zona(zona),
      
      area = as.character(area) %>% str_squish(),
      area = ifelse(is.na(area) | area == "", "Não informado", area),
      
      ponto = as.character(ponto) %>% str_squish(),
      ponto = ifelse(is.na(ponto) | ponto == "", "Não informado", ponto),
      
      pescador_cod = as.character(pescador_cod) %>% str_squish(),
      
      semanatot = to_number(semanatot),
      diastot = to_number(diastot),
      
      cpue = ifelse(
        !is.na(semanatot) & !is.na(diastot) & diastot > 0,
        semanatot / diastot,
        NA_real_
      ),
      
      is_tilapia = identificar_tilapia(especie_limpa)
    )
}

