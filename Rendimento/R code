ref_espacial <- ref_biometria %>%
  transmute(
    area_ref = limpar_valor_local(area),
    ponto_ref = limpar_valor_local(ponto),
    zona_ref = padronizar_zona(zona),
    
    area_key = limpar_chave_local(area),
