}

normalizar_codigo_especie <- function(x) {
  x %>%
    as.character() %>%
    str_squish() %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_lower() %>%
    str_replace_all("[^a-z0-9]+", " ") %>%
    str_squish()
}

identificar_tilapia <- function(especie_limpa) {
  # Reconhece tilápias por códigos, nomes comuns e nomes científicos.
  # Importante: "tilapi" é tratado como sinônimo em TODOS os anos,
  # não apenas em 2008 e 2009.
  x <- normalizar_codigo_especie(especie_limpa)
  x_compacto <- str_replace_all(x, "\\s+", "")
  
  case_when(
    is.na(x) | x == "" ~ FALSE,
    x_compacto %in% c("tilapi", "tilapia", "tilapias", "tilap", "tila", "til") ~ TRUE,
    str_detect(x_compacto, "^tilapi") ~ TRUE,
    str_detect(x_compacto, "^tilap") ~ TRUE,
    str_detect(x, "\\btilapia\\b|\\btilapias\\b") ~ TRUE,
    str_detect(x, "\\boreochromis\\b|\\bniloticus\\b|\\bnilotic\\b") ~ TRUE,
    str_detect(x, "\\bcoptodon\\b|\\brendalli\\b|\\brendali\\b|\\brendal\\b") ~ TRUE,
    TRUE ~ FALSE
  )
}

classificar_grupo_especie <- function(especie_limpa) {
  ifelse(identificar_tilapia(especie_limpa), "Tilápias", "Outras espécies")
}

