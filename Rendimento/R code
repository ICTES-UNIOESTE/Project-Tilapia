resumir_cpue <- function(.data, ...) {
  .data %>%
    group_by(...) %>%
    summarise(
      rendimento_total = sum(semanatot, na.rm = TRUE),
      dias_total = sum(diastot, na.rm = TRUE),
      
      cpue_media = mean(cpue, na.rm = TRUE),
      cpue_dp = sd(cpue, na.rm = TRUE),
      n_cpue = sum(!is.na(cpue)),
      cpue_se = ifelse(n_cpue > 1, cpue_dp / sqrt(n_cpue), NA_real_),
      cpue_lwr = ifelse(is.na(cpue_se), NA_real_, pmax(cpue_media - cpue_se, 0)),
      cpue_upr = ifelse(is.na(cpue_se), NA_real_, cpue_media + cpue_se),
      
      cpue_agregada = ifelse(dias_total > 0, rendimento_total / dias_total, NA_real_),
      
      n_registros = n(),
      n_pescadores = n_distinct(pescador_cod[pescador_cod != "" & !is.na(pescador_cod)]),
      .groups = "drop"
    )
}

