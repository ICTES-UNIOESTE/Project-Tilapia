    area_ref_ponto = moda_valida(area_ref),
    ponto_ref_ponto = moda_valida(ponto_ref),
    zona_ref_ponto = moda_valida(zona_ref),
    .groups = "drop"
  ) %>%
  filter(n_area_ref == 1, n_zona_ref == 1)

