limpar_texto <- function(x) {
  x %>%
    as.character() %>%
    str_squish() %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_lower() %>%
    str_replace_all("\\s+", " ")
}

padronizar_zona <- function(x) {
  x_chr <- as.character(x) %>% str_squish()
  x_clean <- limpar_texto(x_chr)
  
  case_when(
    is.na(x_chr) | x_chr == "" ~ "Não informado",
    x_clean == "lacustre" ~ "Lacustre",
    x_clean == "fluvial" ~ "Fluvial",
    x_clean == "transicao" ~ "Transição",
    x_clean == "transição" ~ "Transição",
    x_clean == "montante" ~ "Montante",
    x_clean == "nao informado" ~ "Não informado",
    TRUE ~ str_to_title(x_chr)
  )
}

to_number <- function(x) {
  x_clean <- x %>%
    as.character() %>%
    str_squish() %>%
    str_replace_all(",", ".")
  
  readr::parse_number(
    x_clean,
    locale = readr::locale(decimal_mark = "."),
    na = c("", "-", "--", "NA", "NaN", "na", "nan", "f", "F")
  )
}

parse_data_robusta <- function(v) {
  v_chr <- as.character(v) %>% str_squish()
  
  v_chr[v_chr == ""] <- NA_character_
  v_chr[tolower(v_chr) %in% c("na", "nan", "null")] <- NA_character_
  
  d <- rep(as.Date(NA), length(v_chr))
  
  idx_valid <- !is.na(v_chr)
  d[idx_valid] <- suppressWarnings(lubridate::dmy(v_chr[idx_valid]))
  
  idx_num <- is.na(d) & !is.na(v_chr) & grepl("^\\d+(\\.0)?$", v_chr)
  if (any(idx_num, na.rm = TRUE)) {
    d[idx_num] <- as.Date(as.numeric(v_chr[idx_num]), origin = "1899-12-30")
  }
  
  idx_ymd <- is.na(d) & !is.na(v_chr)
  if (any(idx_ymd, na.rm = TRUE)) {
    d[idx_ymd] <- suppressWarnings(lubridate::ymd(v_chr[idx_ymd]))
  }
  
  idx_periodo <- is.na(d) &
    !is.na(v_chr) &
    stringr::str_detect(v_chr, "\\d{1,2}/\\d{1,2}/\\d{2,4}")
  
  if (any(idx_periodo, na.rm = TRUE)) {
    primeira_data <- stringr::str_extract(
      v_chr[idx_periodo],
      "\\d{1,2}/\\d{1,2}/\\d{2,4}"
    )
    
    d[idx_periodo] <- suppressWarnings(lubridate::dmy(primeira_data))
  }
  
  d
}

nome_mes_pt <- function(mes_num) {
  factor(
    mes_num,
    levels = 1:12,
    labels = c(
      "Jan", "Fev", "Mar", "Abr", "Mai", "Jun",
      "Jul", "Ago", "Set", "Out", "Nov", "Dez"
    )
  )
}

identificar_tilapia <- function(especie_limpa) {
  str_detect(
    especie_limpa,
    paste0(
      "\\btilapia\\b|\\btilapias\\b|",
      "\\btilap\\b|^tilap|",
      "\\btila\\b|^tila$|",
      "\\btil\\b|^til$|",
      "\\boreochromis\\b|\\bniloticus\\b|\\bnilotic\\b|",
      "\\bcoptodon\\b|\\brendalli\\b|\\brendali\\b|\\brendal\\b"
    )
  )
}

