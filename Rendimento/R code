caminho_biometria_ref <- "C:/Users/lg_ri/Desktop/Monitoramento Tilapia/TILÁPIAS Biometria 1998_2025.xlsx"

limpar_valor_local <- function(x) {
  x_chr <- x %>%
    as.character() %>%
    str_squish() %>%
    str_replace_all("^Área\\s*", "") %>%
    str_replace_all("^Area\\s*", "") %>%
    str_replace_all("^Ponto\\s*", "") %>%
    str_replace_all("^Zona\\s*", "") %>%
    str_squish()
  
  x_chr[x_chr == ""] <- NA_character_
  x_chr[toupper(stringi::stri_trans_general(x_chr, "Latin-ASCII")) %in%
          c("NA", "NAN", "NAO INFORMADO", "NÃO INFORMADO", "NULL")] <- NA_character_
  
  x_chr
}

limpar_chave_local <- function(x) {
  limpar_valor_local(x) %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_upper() %>%
    str_squish()
}

moda_valida <- function(x) {
  y <- x[!is.na(x) & x != "" & x != "Não informado"]
  if (length(y) == 0) return(NA_character_)
  
  names(sort(table(y), decreasing = TRUE))[1]
}

if (!file.exists(caminho_biometria_ref)) {
  stop("Arquivo de referência espacial não encontrado: ", caminho_biometria_ref)
}

ref_biometria <- suppressWarnings(
  readxl::read_excel(caminho_biometria_ref, sheet = "Planilha1", col_types = "text")
) %>%
  janitor::clean_names()

if (!all(c("area", "zona", "ponto") %in% names(ref_biometria))) {
  stop(
    "A Planilha1 do arquivo de biometria precisa conter as colunas AREA, ZONA e PONTO. ",
