}

.read_sheet_as_text <- function(path, sheet) {
  header <- suppressWarnings(readxl::read_excel(path, sheet = sheet, n_max = 0))
  ncols <- ncol(header)
  if (is.null(ncols) || ncols == 0) return(NULL)
  
  col_types <- rep("text", ncols)
  suppressWarnings(readxl::read_excel(path, sheet = sheet, col_types = col_types))
}

to_number <- function(x) {
  x_clean <- x %>%
    as.character() %>%
    str_squish() %>%
    str_replace_all(",", ".")
  
  x_num <- readr::parse_number(
    x_clean,
    locale = readr::locale(decimal_mark = "."),
    na = c("", "-", "--", "NA", "NaN", "na", "nan", "f", "F")
  )
  
  dplyr::if_else(
    is.na(x_num) | x_num <= 0,
    NA_real_,
    x_num
  )
}

