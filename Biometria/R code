tab_zona <- dados %>%
  mutate(ZONA = padronizar_zona_biopesca(ZONA)) %>%
  filter(!is.na(ZONA)) %>%
  group_by(ZONA) %>%
  summarise(total_peixes = n(), .groups = "drop") %>%
  tidyr::crossing(especie_alvo = factor(niveis_alvo, levels = niveis_alvo)) %>%
  left_join(
    dados_alvo %>%
      mutate(ZONA = padronizar_zona_biopesca(ZONA)) %>%
      filter(!is.na(ZONA)) %>%
