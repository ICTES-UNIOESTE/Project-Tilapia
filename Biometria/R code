padronizar_sexo <- function(x) {
  x_clean <- x %>%
    as.character() %>%
    str_squish() %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_upper()
  
  case_when(
    is.na(x_clean) | x_clean == "" ~ "Não informado",
    x_clean %in% c("M", "MACHO", "MASCULINO") ~ "Macho",
    x_clean %in% c("F", "FEMEA", "FEMININO") ~ "Fêmea",
    TRUE ~ "Não informado"
  )
}

padronizar_estadio <- function(x) {
  x_clean <- x %>%
    as.character() %>%
    str_squish() %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_upper()
  
  case_when(
    is.na(x_clean) | x_clean == "" ~ "NÃO INFORMADO",
    str_detect(x_clean, "IMT|IMAT") ~ "IMT",
    str_detect(x_clean, "^MAT$|MATUR") ~ "MAT",
    str_detect(x_clean, "RPD|REPROD") ~ "RPD",
    str_detect(x_clean, "ESG|ESGOT") ~ "ESG",
    str_detect(x_clean, "REG|REGR") ~ "REG",
    TRUE ~ "NÃO INFORMADO"
  )
}

