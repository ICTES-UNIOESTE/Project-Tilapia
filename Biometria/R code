# ======================
# 4A. Aplicar correções espaciais a partir do arquivo de biometria
# ======================

caminho_biometria_ref <- "C:/Users/lg_ri/Desktop/Monitoramento Tilapia/TILÁPIAS Biometria 1998_2025.xlsx"
correcao_espacial <- carregar_correcao_espacial(caminho_biometria_ref)

if (!is.null(correcao_espacial)) {
  
  correcao_exata <- correcao_espacial %>%
    distinct(
      zona_orig_ref, area_orig_ref, ponto_orig_ref,
      zona_corr, area_corr, ponto_corr
    )
  
  correcao_ponto <- correcao_espacial %>%
    filter(!is.na(ponto_orig_ref)) %>%
    group_by(ponto_orig_ref) %>%
    summarise(
      zona_corr_ponto = first_non_missing(zona_corr),
      area_corr_ponto = first_non_missing(area_corr),
      ponto_corr_ponto = first_non_missing(ponto_corr),
      .groups = "drop"
    )
  
  dados <- dados %>%
    mutate(
      zona_orig_ref  = limpar_ref_espacial(ZONA),
      area_orig_ref  = limpar_ref_espacial(AREA),
      ponto_orig_ref = limpar_ref_espacial(PONTO)
    ) %>%
    left_join(
      correcao_exata,
      by = c("zona_orig_ref", "area_orig_ref", "ponto_orig_ref")
    ) %>%
    left_join(
      correcao_ponto,
      by = "ponto_orig_ref"
    ) %>%
    mutate(
      ZONA  = coalesce(zona_corr, zona_corr_ponto, ZONA),
      AREA  = coalesce(area_corr, area_corr_ponto, AREA),
      PONTO = coalesce(ponto_corr, ponto_corr_ponto, PONTO)
    ) %>%
    select(
      -zona_orig_ref, -area_orig_ref, -ponto_orig_ref,
      -zona_corr, -area_corr, -ponto_corr,
      -zona_corr_ponto, -area_corr_ponto, -ponto_corr_ponto
    )
}

