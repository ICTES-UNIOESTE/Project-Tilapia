fmt_num_pt <- function(x, digits = 2, drop0 = TRUE) {
  out <- ifelse(
    is.na(x),
    NA_character_,
    formatC(
      x,
      format = "f",
      digits = digits,
      decimal.mark = ",",
      big.mark = "."
    )
  )
  
  if (drop0) {
    out <- stringr::str_replace(out, "(,\\d*?)0+$", "\\1")
    out <- stringr::str_replace(out, ",$", "")
  }
  
  out
}

fmt_percent_pt <- function(x, digits = 2, drop0 = TRUE) {
  ifelse(
    is.na(x),
    NA_character_,
    paste0(fmt_num_pt(x, digits = digits, drop0 = drop0), "%")
  )
}

label_num_pt <- function(digits = 2, drop0 = TRUE) {
  function(x) fmt_num_pt(x, digits = digits, drop0 = drop0)
}

label_percent_pt <- function(digits = 2, drop0 = TRUE) {
  function(x) fmt_percent_pt(x, digits = digits, drop0 = drop0)
}

