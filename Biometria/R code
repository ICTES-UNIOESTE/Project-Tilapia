padronizar_zona_biopesca <- function(x) {
  x_clean <- x %>%
    as.character() %>%
    str_squish() %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_lower()
  
  case_when(
    is.na(x_clean) | x_clean == "" ~ "Não informado",
    
    x_clean %in% c("transicao", "transição", "tran") ~ "Transição",
    x_clean %in% c("fluvial", "flu", "fluv") ~ "Fluvial",
    x_clean %in% c("lacustre", "lacu") ~ "Lacustre",
    
    x_clean %in% c("nao informado", "não informado") ~ "Não informado",
    
    x_clean %in% c("montante") ~ NA_character_,
    
    TRUE ~ str_to_title(x_clean)
  )
}

pick_first <- function(x, patterns) {
  for (p in patterns) {
    idx <- which(str_detect(x, regex(p, ignore_case = TRUE)))
    if (length(idx) > 0) return(x[idx[1]])
  }
  return(NA_character_)
}

first_non_missing <- function(x) {
  y <- x[!is.na(x) & x != ""]
  if (length(y) == 0) return(NA_character_)
  y[1]
}

limpar_ref_espacial <- function(x) {
  x %>%
    as.character() %>%
    str_squish() %>%
    na_if("") %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_upper()
}

carregar_correcao_espacial <- function(path_biometria) {
  
  if (!file.exists(path_biometria)) {
    message("Arquivo de biometria não encontrado. Correções espaciais não serão aplicadas.")
    return(NULL)
  }
  
  abas <- readxl::excel_sheets(path_biometria)
  
  ref <- NULL
  aba_usada <- NA_character_
  
  for (aba in abas) {
    ref_teste <- suppressWarnings(
      readxl::read_excel(path_biometria, sheet = aba, col_types = "text")
    ) %>%
      janitor::clean_names()
    
    nms_teste <- names(ref_teste)
    tem_colunas_espaciais <- any(str_detect(nms_teste, regex("^area$|^area_", ignore_case = TRUE))) &&
      any(str_detect(nms_teste, regex("^zona$|^zona_", ignore_case = TRUE))) &&
      any(str_detect(nms_teste, regex("^ponto$|^ponto_|^local$", ignore_case = TRUE)))
    
    if (tem_colunas_espaciais) {
      ref <- ref_teste
      aba_usada <- aba
      break
    }
  }
  
  if (is.null(ref)) {
    message("Nenhuma aba com AREA, ZONA e PONTO foi encontrada no arquivo de biometria. Correções espaciais não serão aplicadas.")
    return(NULL)
  }
  
  message("Aba usada como referência espacial da biometria: ", aba_usada)
  
  nms <- names(ref)
  
  ponto_orig_col <- pick_first(nms, c(
    "^ponto$", "^ponto_original$", "^ponto_orig$", "^local$", "^local_original$"
  ))
  ponto_corr_col <- pick_first(nms, c(
    "^ponto_corrigido$", "^ponto_correto$", "^ponto_novo$", "^ponto_padronizado$", "^ponto_ref$"
  ))
  
  area_orig_col <- pick_first(nms, c(
    "^area$", "^area_original$", "^area_orig$"
  ))
  area_corr_col <- pick_first(nms, c(
    "^area_corrigida$", "^area_correta$", "^area_nova$", "^area_padronizada$", "^area_ref$"
  ))
  
  zona_orig_col <- pick_first(nms, c(
    "^zona$", "^zona_original$", "^zona_orig$"
  ))
  zona_corr_col <- pick_first(nms, c(
    "^zona_corrigida$", "^zona_correta$", "^zona_nova$", "^zona_padronizada$", "^zona_ref$"
  ))
  
  out <- ref %>%
    transmute(
      ponto_orig = if (!is.na(ponto_orig_col)) .data[[ponto_orig_col]] else NA_character_,
      ponto_corr = if (!is.na(ponto_corr_col)) .data[[ponto_corr_col]] else NA_character_,
      area_orig  = if (!is.na(area_orig_col))  .data[[area_orig_col]]  else NA_character_,
      area_corr  = if (!is.na(area_corr_col))  .data[[area_corr_col]]  else NA_character_,
      zona_orig  = if (!is.na(zona_orig_col))  .data[[zona_orig_col]]  else NA_character_,
      zona_corr  = if (!is.na(zona_corr_col))  .data[[zona_corr_col]]  else NA_character_
    ) %>%
    mutate(
      ponto_orig_ref = limpar_ref_espacial(ponto_orig),
      area_orig_ref  = limpar_ref_espacial(area_orig),
      zona_orig_ref  = limpar_ref_espacial(zona_orig),
      ponto_corr     = as.character(ponto_corr) %>% str_squish() %>% na_if(""),
      area_corr      = as.character(area_corr) %>% str_squish() %>% na_if(""),
      zona_corr      = as.character(zona_corr) %>% str_squish() %>% na_if("")
    ) %>%
    filter(
      !is.na(ponto_orig_ref) | !is.na(area_orig_ref) | !is.na(zona_orig_ref)
    )
  
  out
}

