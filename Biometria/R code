    n_alvo = replace_na(n_alvo, 0L),
    percentual_alvo = 100 * n_alvo / total_peixes,
    ZONA = factor(
      ZONA,
      levels = c("Não informado", "Fluvial", "Lacustre", "Transição")
    )
  ) %>%
  arrange(especie_alvo, ZONA)

tab_ponto <- dados %>%
  mutate(
    ZONA = ifelse(is.na(ZONA) | ZONA == "", "Não informado", ZONA),
    PONTO = ifelse(is.na(PONTO) | PONTO == "", "Não informado", PONTO)
  ) %>%
  group_by(ZONA, PONTO) %>%
  summarise(total_peixes = n(), .groups = "drop") %>%
  tidyr::crossing(especie_alvo = factor(niveis_alvo, levels = niveis_alvo)) %>%
  left_join(
    dados_alvo %>%
      mutate(
        ZONA = ifelse(is.na(ZONA) | ZONA == "", "Não informado", ZONA),
        PONTO = ifelse(is.na(PONTO) | PONTO == "", "Não informado", PONTO)
      ) %>%
      count(especie_alvo, ZONA, PONTO, name = "n_alvo"),
    by = c("especie_alvo", "ZONA", "PONTO")
  ) %>%
  mutate(
    n_alvo = replace_na(n_alvo, 0L),
    percentual_alvo = 100 * n_alvo / total_peixes
  ) %>%
  filter(n_alvo > 0) %>%
  arrange(especie_alvo, desc(n_alvo))

tab_sexo <- dados_alvo %>%
  mutate(SEXO = ifelse(is.na(SEXO) | SEXO == "", "Não informado", SEXO)) %>%
  mutate(SEXO = factor(SEXO, levels = c("Macho", "Fêmea", "Não informado"))) %>%
  count(especie_alvo, SEXO, name = "n") %>%
  group_by(especie_alvo) %>%
  mutate(percentual = 100 * n / sum(n)) %>%
  ungroup() %>%
  arrange(especie_alvo, SEXO)

tab_estadio <- dados_alvo %>%
  mutate(
