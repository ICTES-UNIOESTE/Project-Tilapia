    especie_alvo = factor(especie_alvo, levels = niveis_alvo)
  ) %>%
  count(especie_alvo, ESTADIO, name = "n", .drop = FALSE) %>%
  group_by(especie_alvo) %>%
  mutate(
    percentual = ifelse(sum(n) > 0, 100 * n / sum(n), 0)
