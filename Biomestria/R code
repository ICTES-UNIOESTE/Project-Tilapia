parse_data_robusta <- function(v) {
  v_chr <- as.character(v)
  v_chr <- stringr::str_squish(v_chr)
  v_chr[v_chr == ""] <- NA_character_
  
  d <- rep(as.Date(NA), length(v_chr))
  
  idx_valid <- !is.na(v_chr)
  d[idx_valid] <- suppressWarnings(lubridate::dmy(v_chr[idx_valid]))
  
  idx_num <- is.na(d) & !is.na(v_chr) & grepl("^\\d+(\\.0)?$", v_chr)
  if (any(idx_num, na.rm = TRUE)) {
    d[idx_num] <- as.Date(as.numeric(v_chr[idx_num]), origin = "1899-12-30")
  }
  
  idx_ymd <- is.na(d) & !is.na(v_chr)
  if (any(idx_ymd, na.rm = TRUE)) {
    d[idx_ymd] <- suppressWarnings(lubridate::ymd(v_chr[idx_ymd]))
  }
  
  d
}

clean_species_name <- function(x) {
  x %>%
    as.character() %>%
    str_squish() %>%
    stringi::stri_trans_general("Latin-ASCII") %>%
    str_to_lower() %>%
    str_replace_all("\\s+", " ")
}

.read_sheet_as_text <- function(path, sheet) {
  header <- suppressWarnings(readxl::read_excel(path, sheet = sheet, n_max = 0))
  ncols <- ncol(header)
  if (is.null(ncols) || ncols == 0) return(NULL)
  
  col_types <- rep("text", ncols)
  suppressWarnings(readxl::read_excel(path, sheet = sheet, col_types = col_types))
}

to_number <- function(x) {
  x_clean <- x %>%
    as.character() %>%
    str_squish() %>%
    str_replace_all(",", ".")
  
  x_num <- readr::parse_number(
    x_clean,
    locale = readr::locale(decimal_mark = "."),
    na = c("", "-", "--", "NA", "NaN", "na", "nan", "f", "F")
  )
  
  dplyr::if_else(
    is.na(x_num) | x_num <= 0,
    NA_real_,
    x_num
  )
}

safe_file_name <- function(x) {
  x %>%
    str_replace_all(" ", "_") %>%
    str_replace_all("[^A-Za-z0-9_]+", "")
}

pretty_group_label_pt <- function(x) {
  dplyr::case_when(
    x == "Oreochromis niloticus" ~ "italic('Oreochromis niloticus')",
    x == "Coptodon rendalli" ~ "italic('Coptodon rendalli')",
    x == "Ambas as espécies combinadas" ~ "italic('Oreochromis niloticus')~' + '~italic('Coptodon rendalli')",
    TRUE ~ paste0("'", x, "'")
  )
}

# ======================
# 3. Ler uma planilha
# ======================

ler_dado <- function(arq) {
  
  ano_file <- str_extract(basename(arq), "\\d{4}") %>% as.integer()
  
  shs <- suppressWarnings(readxl::excel_sheets(arq))
  if (length(shs) == 0) {
    message("Sem abas legíveis: ", basename(arq))
    return(NULL)
  }
  
  shs <- shs[!grepl(
    "^(Gr[aá]f|Gr[aá]fico|Chart|Figura|Object|Grf|Sheet\\d+$)",
    shs,
    ignore.case = TRUE
  )]
  
  if (length(shs) == 0) {
    message("Só havia abas de gráfico/objeto em: ", basename(arq))
    return(NULL)
  }
  
  for (sh in shs) {
    
    df <- purrr::safely(.read_sheet_as_text, otherwise = NULL)(arq, sh)$result
    if (is.null(df)) next
    
    df <- df %>%
      janitor::clean_names()
    
    df <- df %>%
      rename(
        DATA = any_of(c(
          "data", "date", "dt", "data_coleta"
        )),
        SPECIES = any_of(c(
          "species", "especie", "esp_cie", "nome_cientifico",
          "nome_cientifico_atualizado", "especie_atualizada"
        )),
        ESTADIO = any_of(c(
          "estadio", "estagio", "estágio", "stage",
          "estadio_gonadal", "estagio_gonadal"
        )),
        SEXO = any_of(c(
          "sexo", "sex"
        )),
        CT = any_of(c(
          "ct", "comprimento_total", "comp_total", "total_length",
          "lt", "tl"
        )),
        CP = any_of(c(
          "cp", "comprimento_padrao", "comp_padrao", "standard_length",
          "ls", "sl"
        )),
        ZONA = any_of(c(
          "zona", "zona_de_pesca", "zona_pesca"
        )),
        AREA = any_of(c(
          "area", "regiao", "regiao_pesca"
        )),
        PONTO = any_of(c(
          "ponto", "local", "localidade", "ponto_de_pesca",
          "ponto_pesca"
        ))
      )
    
    if (!all(c("DATA", "SPECIES") %in% names(df))) next
    
    optional_cols <- c("ESTADIO", "SEXO", "CT", "CP", "ZONA", "AREA", "PONTO")
    for (cc in optional_cols) {
      if (!cc %in% names(df)) df[[cc]] <- NA_character_
    }
    
    return(
      df %>%
        transmute(
          DATA,
          SPECIES,
          ESTADIO,
          SEXO,
          CT,
          CP,
          ZONA,
          AREA,
          PONTO,
          ANO = ano_file,
          .orig_sheet = sh,
          .orig_file = basename(arq)
        )
    )
  }
  
  message("Nenhuma aba com DATA/SPECIES em: ", basename(arq))
  NULL
}

