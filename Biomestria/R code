arquivos <- list.files(
  pasta,
  pattern = "^Biopesca\\s\\d{4}\\.xlsx$",
  full.names = TRUE
)

arquivos <- arquivos[
  str_extract(basename(arquivos), "\\d{4}") %>%
    as.integer() %>%
    between(1988, 2025)
]

if (length(arquivos) == 0) {
  stop("Nenhum arquivo chamado 'Biopesca YYYY.xlsx' foi encontrado entre 1988 e 2025.")
}

dados_lista <- lapply(arquivos, ler_dado) %>%
  purrr::compact()

if (length(dados_lista) == 0) {
  stop("Nenhum dado válido foi lido. Verifique se os arquivos possuem colunas DATA e SPECIES/ESPECIE.")
}

dados <- bind_rows(dados_lista) %>%
  mutate(
    DATA = parse_data_robusta(DATA),
    ANO = ifelse(is.na(ANO), year(DATA), ANO),
    ANO = as.integer(ANO),
    MES = month(DATA),
    
    SPECIES_ORIGINAL = as.character(SPECIES) %>% str_squish(),
    SPECIES_CLEAN = clean_species_name(SPECIES),
    
    ESTADIO = as.character(ESTADIO) %>%
      str_squish() %>%
      stringi::stri_trans_general("Latin-ASCII") %>%
      str_to_upper(),
    
    SEXO = as.character(SEXO) %>%
      str_squish() %>%
      stringi::stri_trans_general("Latin-ASCII") %>%
      str_to_upper(),
    
    ZONA = as.character(ZONA) %>% str_squish(),
    AREA = as.character(AREA) %>% str_squish(),
    PONTO = as.character(PONTO) %>% str_squish(),
    
    CT = to_number(CT),
    CP = to_number(CP),
    
    especie_alvo = case_when(
      SPECIES_CLEAN %in% c(
        "oreochromis niloticus",
        "oreochromis niloticus niloticus"
      ) ~ "Oreochromis niloticus",
      
      SPECIES_CLEAN %in% c(
        "coptodon rendalli",
        "coptodon rendali",
        "tilapia rendalli",
        "tilapia rendali"
      ) ~ "Coptodon rendalli",
      
      str_detect(SPECIES_CLEAN, "oreochromis\\s+nilotic") ~ "Oreochromis niloticus",
      str_detect(SPECIES_CLEAN, "coptodon\\s+rendal|coptodon\\s+rendali|tilapia\\s+rendal|tilapia\\s+rendali") ~ "Coptodon rendalli",
      
      TRUE ~ NA_character_
    ),
    
    is_alvo = !is.na(especie_alvo)
  ) %>%
  filter(
    !is.na(ANO),
    ANO >= 1988,
    ANO <= 2025,
    !is.na(SPECIES_CLEAN),
    SPECIES_CLEAN != ""
  )

